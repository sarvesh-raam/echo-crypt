{
  "name": "@echocrypt/crypto",
  "version": "1.0.0",
  "private": true,
  "description": "Isomorphic Web Crypto primitives for EchoCrypt (ECDH P-256, HKDF, AES-256-GCM, ECDSA).",
  "type": "module",
