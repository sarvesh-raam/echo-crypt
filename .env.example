# Local development (npm run dev:server). Docker Compose has its own defaults.
MONGO_URL=mongodb://localhost:27017/echocrypt
REDIS_URL=redis://localhost:6379
# Required in production: at least 32 random characters, identical on every instance.
JWT_SECRET=
PORT=4000
# INSTANCE_ID=local
# Proxy hops in front of the server (decides the IP used for rate limits). 1 = one reverse proxy.
# TRUST_PROXY=1
