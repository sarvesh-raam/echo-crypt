# Local development (npm run dev:server). Docker Compose has its own defaults.
MONGO_URL=mongodb://localhost:27017/echocrypt
REDIS_URL=redis://localhost:6379
# Required in production: at least 32 random characters, identical on every instance.
JWT_SECRET=
PORT=4000
# INSTANCE_ID=local
# Proxy hops in front of the server (decides the IP used for rate limits). 1 = one reverse proxy.
# TRUST_PROXY=1

# Public address of the app (passkeys and OAuth redirects). Render sets RENDER_EXTERNAL_URL itself.
# PUBLIC_URL=https://chat.example.com

# Optional sign-in methods, each hidden until configured. Setup: docs/deploy-render.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Email codes through Brevo (free: 300 a day). In development without a key, codes go to the server log.
# BREVO_API_KEY=
# MAIL_FROM=you@example.com
